pkgname=gnome-software
pkgver=50.3
pkgrel=1
pkgdesc="Allows you to find and install new apps"
url="https://apps.gnome.org/Software"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(
  appstream
  dconf
  gdk-pixbuf2
  glib2
  glibc
  gnome-app-list
  gsettings-desktop-schemas
  gtk4
  hicolor-icon-theme
  json-glib
  libadwaita
  libgcc
  libgudev
  libmalcontent
  libsoup3
  libsysprof-capture
  libxmlb
  pango
  polkit
  systemd
)
makedepends=(
  docbook-xsl
  flatpak
  fwupd
  git
  glib2-devel
  gobject-introspection
  gtk-doc
  itstool
  libglib-testing
  malcontent
  meson
	packagekit
)
optdepends=(
	'archlinux-appstream-data: native package display'
	'packagekit: packagekit support plugin'
  'flatpak: Flatpak support plugin'
  'fwupd: fwupd support plugin'
  'malcontent: Parental control plugin'
)
groups=(gnome)
source=(
  "git+https://gitlab.gnome.org/GNOME/gnome-software.git?signed#tag=${pkgver/[a-z]/.&}"
  "git+https://gitlab.gnome.org/mwleeds/gnome-pwa-list.git"
)
b2sums=('592b91c562b569ce72a613bd19a425df8f91e564d90dee6efda2967dd35eb367d6b82896e74bc20af00c45f7ea626e8fb190ddc6f1eb4992d98f0a41aecf4639'
        'SKIP')
validpgpkeys=(
  2AA441054BD2F1715EC11610FB183E7EF3C36A0D # Milan Crha <mcrha@redhat.com>
  923B7025EE03C1C59F42684CF0942E894B2EAFA0 # Philip Withnall <pwithnall@gnome.org>
)

prepare() {
  cd $pkgname

  git submodule init
  git submodule set-url subprojects/gnome-pwa-list "$srcdir/gnome-pwa-list"
  git -c protocol.file.allow=always -c protocol.allow=never submodule update
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

# Not running tests - need root and a D-Bus system bus

package() {
  meson install -C build --destdir "$pkgdir"
}

